# ====================================================================
# VALLE A LAS ESTRELLAS — VARIABLES DE ENTORNO DE EJEMPLO
# Copia este archivo a .env.local para desarrollo local
# ====================================================================

# 1. Notificación Privada de Suscripciones (Servidor únicamente)
# Dirección donde el equipo recibe las nuevas alertas de suscriptores
NOTIFY_EMAIL=tu-correo@ejemplo.com

# Remitente verificado para envío de correos (ej. Resend)
FROM_EMAIL=onboarding@resend.dev

# Clave API del servicio de correo Resend (https://resend.com)
RESEND_API_KEY=re_123456789_ejemplo

# 2. Seguridad del Panel Administrativo (/admin)
ADMIN_PASSWORD=elqui2026

# 3. Base de Datos Supabase (Opcional - La app cuenta con Adaptador Local Resiliente si no se configuran)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo_service_role
